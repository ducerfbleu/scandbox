# Build stage: compile the static, zero-dependency gateway binary.
FROM golang:1.23-alpine AS build
RUN apk add --no-cache ca-certificates
WORKDIR /src
COPY go.mod gateway.go ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /gateway .

# Final stage: nothing but the binary + CA roots (used only for strict remote TLS;
# ignored when GATEWAY_TLS_VERIFY=0). No interpreter, no shell, no package manager.
FROM scratch
COPY --from=build /gateway /gateway
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
EXPOSE 8080
ENTRYPOINT ["/gateway"]
